        <[int32][Version][230]>
        <[list_vector4_float64][ContactSpheres][ (0.164 0.0 -0.52 0.174) (-4.12 0.0 -0.09 0.099) (-0.036 7.492 0.424 0.030) (-0.036 -7.492 0.424 0.030) ]>
        <[stringt8c][ICAO][DG10]>
        <[string8][DisplayName][DG-101G]>
        <[string8][DisplayNameFull][Glaser-Dirks DG-101G]>
        <[list_localized_text][Descriptions][]
            <[localized_text][element][0]
                <[string8u][Language][en]>
                <[string8][Text][The DG-100 of 1974 is the first sailplane manufactured by Glaser-Dirks, developed from the Akaflieg Darmstadt D-38, the Standard class sailplane was designed by Wilhelm Dirks. Converted from FlightGear by Krzysztof Kaniewski. Original 3D design by Nikolaus Kerner.]>
            >
            <[localized_text][element][1]
                <[string8u][Language][de]>
                <[string8][Text][Die Glaser-Dirks DG-100 war der erste Segelflugzeugtyp, den der Segelflugzeughersteller Glaser-Dirks (heute: DG Flugzeugbau) ab 1973 entwarf und der am 10. Mai 1974 seinen Erstflug hatte.  Konvertiert von FlightGear durch Krzysztof Kaniewski. 3d-Modell erstellt von Nikolaus Kerner.]>
            >
            <[localized_text][element][2]
                <[string8u][Language][fr]>
                <[string8][Text][Le DG-100 de 1974 est le premier planeur fabriqué par Glaser-Dirks, développé à partir de l'Akaflieg Darmstadt D-38. Ce planeur de classe Standard a été conçu par Wilhelm Dirks. Converti à partir de FlightGear par Krzysztof Kaniewski. Conception 3D originale par Nikolaus Kerner.]>
            >
            <[localized_text][element][3]
                <[string8u][Language][es]>
                <[string8][Text][El DG-100 de 1974 es el primer planeador fabricado por Glaser-Dirks, desarrollado a partir del Akaflieg Darmstadt D-38. El planeador de clase estándar fue diseñado por Wilhelm Dirks. Convertido desde FlightGear por Krzysztof Kaniewski. Diseño 3D original de Nikolaus Kerner.]>
            >
            <[localized_text][element][4]
                <[string8u][Language][it]>
                <[string8][Text][Il DG-100 del 1974 è il primo aliante prodotto dalla Glaser-Dirks, sviluppato dall'Akaflieg Darmstadt D-38. L'aliante di classe Standard è stato progettato da Wilhelm Dirks. Convertito da FlightGear da Krzysztof Kaniewski. Progetto 3D originale di Nikolaus Kerner.]>
            >
            <[localized_text][element][5]
                <[string8u][Language][pl]>
                <[string8][Text][DG-100 z 1974 roku to pierwszy szybowiec wyprodukowany przez Glaser-Dirks, opracowany na bazie Akaflieg Darmstadt D-38, szybowiec klasy Standard został zaprojektowany przez Wilhelma Dirksa. Przerobiony z FlightGear przez Krzysztofa Kaniewskiego. Oryginalny projekt 3D autorstwa Nikolausa Kernera.]>
            >
        >
